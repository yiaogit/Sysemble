{
  "apiVersion": "sysemble/plan/v1",
  "spec": "minimal-debian-live",
  "base": {
    "kind": "debian",
    "release": "trixie",
    "pin": "2026-11-01"
  },
  "target": {
    "arch": "x86_64",
    "outputs": [
      "iso"
    ]
  },
  "packages": [
    "apt",
    "ca-certificates",
    "console-setup",
    "dbus",
    "e2fsprogs",
    "initramfs-tools",
    "kmod",
    "linux-image-amd64",
    "locales",
    "sudo",
    "systemd",
    "systemd-sysv",
    "tzdata",
    "udev"
  ],
  "modules": [
    {
      "id": "base-debian",
      "version": "0.1.0"
    }
  ],
  "estimates": {
    "image_mb": 500,
    "build_minutes": 6,
    "disk_mb": 2024
  },
  "warnings": [
    {
      "code": "spec.installer.iso_without_installer",
      "path": "/target/output",
      "message": "target.output includes `iso` but installer.enabled is false; an installable ISO needs an installer"
    }
  ]
}
